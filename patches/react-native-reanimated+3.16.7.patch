+- (float)estimateProgressForDuration:(float)keyboardAnimationDuration
+                                  a1:(float)a1
+                                  a2:(float)a2
+                                  b1:(float)b1
+                                  b2:(float)b2
+                                  c1:(float)c1
+                                  c2:(float)c2
