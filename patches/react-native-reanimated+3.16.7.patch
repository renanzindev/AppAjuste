+struct LayoutAnimationsProxy : public MountingOverrideDelegate {
+  mutable std::unordered_map<Tag, std::shared_ptr<Node>> nodeForTag_;
+  mutable std::unordered_map<Tag, LayoutAnimation> layoutAnimations_;
