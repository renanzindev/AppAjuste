+  set() {
+    // NOOP
+  },
+  get() {
+    return null;
+  }
+} : {
+  set(shareable, shareableRef) {
+    cache.set(shareable, shareableRef || shareableMappingFlag);
+  },
+  get: cache.get.bind(cache)
