+}
+
+function makeShareableJS<T extends object>(value: T): T {
+  return value;
+}
+
+function makeShareableNative<T extends object>(value: T): T {
+  if (shareableMappingCache.get(value)) {
+    return value;
+  }
+  const handle = makeShareableCloneRecursive({
+    __init: () => {
+      'worklet';
+      return value;
+    },
