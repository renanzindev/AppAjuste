+struct LayoutAnimation {
+  std::shared_ptr<ShadowView> finalView, currentView, parentView;
+  std::optional<double> opacity;
+  int count = 1;
+  LayoutAnimation &operator=(const LayoutAnimation &other) = default;
+};
