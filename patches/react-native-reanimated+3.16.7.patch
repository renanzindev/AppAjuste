+void UIRuntimeDecorator::decorate(
+    jsi::Runtime &uiRuntime,
+#ifdef RCT_NEW_ARCH_ENABLED
+    const RemoveFromPropsRegistryFunction removeFromPropsRegistry,
+#else
+    const ScrollToFunction scrollTo,
