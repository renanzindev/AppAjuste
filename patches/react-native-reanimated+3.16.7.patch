+  self = [super init];
+  _listeners = [[NSMutableDictionary alloc] init];
+  _nextListenerId = @0;
+  _state = UNKNOWN;
+  _animationStartTimestamp = 0;
+  _isKeyboardObserverAttached = false;
+  NSNotificationCenter *notificationCenter = [NSNotificationCenter defaultCenter];
